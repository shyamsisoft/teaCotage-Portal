# Database Provider Choice: 'mssql' or 'mysql'
DB_PROVIDER=mssql

# (localdb)\MSSQLLocalDB Connection String
MSSQL_SERVER=(localdb)\MSSQLLocalDB
MSSQL_DATABASE=teacottage_cms
MSSQL_CONNECTION_STRING=Server=(localdb)\MSSQLLocalDB;Database=teacottage_cms;Integrated Security=True;TrustServerCertificate=True;

# MySQL Fallback Settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=teacottage_cms

# Secrets & Node Env
NODE_ENV=development
JWT_SECRET=super-secret-jwt-key-teacottage-cms-2026
